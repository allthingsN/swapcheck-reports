{
  "version": 1,
  "cases": [
    {
      "id": "summarize-incident",
      "origin": "team",
      "accepted": true,
      "messages": [
        {
          "role": "system",
          "content": "Summarize the text for a busy manager in at most three short bullet points starting with '- '. Keep every number and name exactly as written. Do not add facts."
        },
        {
          "role": "user",
          "content": "Incident report: On 4 May the checkout service at Fernhill Retail returned errors for 47 minutes. Root cause was an expired TLS certificate on the payments gateway. Priya Nandakumar renewed it and added an expiry alert. About 1,900 orders failed and were retried successfully the same day."
        }
      ],
      "max_tokens": 200,
      "checks": [
        {
          "type": "contains",
          "text": "47 minutes",
          "ignore_case": true
        },
        {
          "type": "contains",
          "text": "TLS certificate",
          "ignore_case": true
        },
        {
          "type": "contains",
          "text": "1,900",
          "ignore_case": true
        },
        {
          "type": "not_contains",
          "text": "database",
          "ignore_case": true
        },
        {
          "type": "not_contains",
          "text": "data loss",
          "ignore_case": true
        },
        {
          "type": "regex",
          "pattern": "^- ",
          "flags": "m"
        },
        {
          "type": "max_tokens_output",
          "max": 160
        },
        {
          "type": "no_refusal"
        }
      ],
      "tags": [
        "summarization"
      ]
    },
