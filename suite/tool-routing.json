    {
      "id": "route-order-details",
      "origin": "team",
      "accepted": true,
      "messages": [
        {
          "role": "system",
          "content": "You are a support assistant for an online store. Use a tool when one fits the request; otherwise answer briefly. Never refund unless the customer asks for a refund."
        },
        {
          "role": "user",
          "content": "What's in order A-10293 and how much was it?"
        }
      ],
      "tools": [
        {
          "name": "lookup_order",
          "description": "Look up an order's items, total and status by its order ID.",
          "parameters": {
            "type": "object",
            "required": [
              "order_id"
            ],
            "additionalProperties": false,
            "properties": {
              "order_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "name": "get_shipping_status",
          "description": "Get the carrier status for a shipment by its tracking number.",
          "parameters": {
            "type": "object",
            "required": [
              "tracking_number"
            ],
            "additionalProperties": false,
            "properties": {
              "tracking_number": {
                "type": "string"
              }
            }
          }
        },
        {
          "name": "refund_order",
          "description": "Issue a refund for an order. Only use when the customer explicitly asks for a refund.",
          "parameters": {
            "type": "object",
            "required": [
              "order_id",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "order_id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "damaged",
                  "not_received",
                  "wrong_item",
                  "other"
                ]
              }
            }
          }
        },
        {
          "name": "escalate_to_human",
          "description": "Hand the conversation to a human agent with a short summary.",
          "parameters": {
            "type": "object",
            "required": [
              "summary"
            ],
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      ],
      "max_tokens": 300,
      "checks": [
